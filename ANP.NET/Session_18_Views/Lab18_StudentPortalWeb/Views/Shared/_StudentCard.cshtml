@model Student

@*
    Yes.Both partials receive one Student but they render different HTML.
    A page can render multiple partials using the same model object because each partial has its own independent rendering
*@

<div class="card">
    <div class="card-body">
        <h5 class="card-title">
            @Model.FullName
        </h5>

        <p class="card-text">
            <strong>Year:</strong> @Model.YearOfStudy
        </p>

        <p class="card-text"><strong>GPA:</strong><gpa-badge for="@Model.Gpa" /></p>
    </div>
</div>
