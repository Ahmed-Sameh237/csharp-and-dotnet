@model Student
@*
    // ==========================
    //          PART A
    // ==========================
    LAB 18 — Lab ID: 8 | CHIP_YEAR = 1 | CHIP_LABEL = Year 1

    Model means one Student here because this partial declares @model Student, 
    while Index.cshtml declares @model List<Student>, so Model's type depends on the @model declaration in each view.
*@

<tr>
    <td>@Model.Id</td>
    <td><a asp-controller="Students" asp-action="Details" asp-route-id="@Model.Id">@Model.FullName</a></td>
    <td><year-chip for="@Model.YearOfStudy"/></td>  @* PART D*@
    <td><gpa-badge for = "@Model.Gpa"/> </td>
</tr>
@* 
    // ==========================
    //          PART B
    // ==========================

    Run these pages:
        /students/year/2
        /students/honours/first
        /students/search?name=a

They look identical to before.

    If <partial name="_StudentRow" /> were used without the model attribute, 
    the partial would inherit the parent view's model (List<Student>). 
    Since _StudentRow expects a single Student, Razor would throw a render-time model type mismatch error.
*@

