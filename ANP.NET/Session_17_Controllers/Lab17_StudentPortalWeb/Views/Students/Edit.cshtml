@model StudentPortalWeb.Models.Student

@{
    ViewData["Title"] = "Edit Student";
}

<h2>Edit Student</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="YearOfStudy" class="form-label"></label>
        <input asp-for="YearOfStudy" class="form-control" />
        <span asp-validation-for="YearOfStudy" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Gpa" class="form-label"></label>
        <input asp-for="Gpa" class="form-control" />
        <span asp-validation-for="Gpa" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
