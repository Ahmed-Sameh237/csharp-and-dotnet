@model List<Student>
@{
    ViewData["Title"] = "Home Page";
}

<style>
    .page-title {
        text-align: center;
        color: #0d6efd;
        font-weight: bold;
        margin: 30px 0;
    }

    .student-table {
        width: 85%;
        margin: auto;
        box-shadow: 0 5px 15px rgba(0,0,0,.15);
        border-radius: 10px;
        overflow: hidden;
    }

        .student-table thead {
            background-color: #0d6efd;
            color: white;
        }

        .student-table tbody tr:hover {
            background-color: #f2f7ff;
        }

        .student-table td,
        .student-table th {
            text-align: center;
            vertical-align: middle;
            padding: 12px;
        }

    .student-count {
        text-align: center;
        margin-bottom: 20px;
        font-size: 18px;
        color: #555;
    }
</style>

<h1 class="page-title">
    Student Portal — Build #156
</h1>
<div class="alert alert-info text-center fs-5">
    <strong>Owner:</strong> @ViewBag.Owner
    <br />
    <strong>Stamp A:</strong> @ViewBag.StampA
    <br />
    <strong>Stamp B:</strong> @ViewBag.StampB
</div>
<p class="student-count">
    Total Students: <strong>@Model.Count</strong>
</p>

<table class="table table-bordered table-hover student-table">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Year Of Study</th>
            <th>GPA</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.FullName</td>
                <td>@student.YearOfStudy</td>
                <td>@student.Gpa.ToString("F2")</td>
            </tr>
        }
    </tbody>
</table>